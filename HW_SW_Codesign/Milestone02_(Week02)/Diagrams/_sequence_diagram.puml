@startuml
title Cross-Traffic Management — Entry Request Sequence based on UPPAAL M/M/1 Model

skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Vehicle 1" as V1
actor "Vehicle 2" as V2
participant "RSU Controller\nUPPAAL Template" as RSU
database "Shared State\nslotOccupied\nv1Waiting\nv2Waiting" as STATE

== Vehicle 1 requests entry ==

V1 -> RSU : request1!
RSU -> STATE : v1Waiting = true\n decisionClock = 0
RSU -> RSU : Move to Decision\ncheck decisionClock <= 100 ms

alt slotOccupied == false and v1Waiting == true
  RSU -> STATE : slotOccupied = true\nv1Waiting = false
  RSU -> V1 : grant1!
  V1 -> V1 : Crossing\nx <= 3000 ms
end

== Vehicle 2 requests while slot may be occupied ==

V2 -> RSU : request2!
RSU -> STATE : v2Waiting = true\n decisionClock = 0

alt Vehicle 1 is still crossing
  RSU -> RSU : Keep Vehicle 2 waiting\nwaitClock <= 10000 ms
else slot free
  RSU -> STATE : slotOccupied = true\nv2Waiting = false
  RSU -> V2 : grant2!
end

== Vehicle 1 completes crossing ==

V1 -> RSU : complete1!
RSU -> STATE : slotOccupied = false

alt v2Waiting == true
  RSU -> RSU : Decision for Vehicle 2\ncheck decisionClock <= 100 ms
  RSU -> STATE : slotOccupied = true\nv2Waiting = false
  RSU -> V2 : grant2!
  V2 -> V2 : Crossing\nx <= 3000 ms
else no vehicle waiting
  RSU -> RSU : Return to Idle
end

== Vehicle 2 completes crossing ==

V2 -> RSU : complete2!
RSU -> STATE : slotOccupied = false
RSU -> RSU : Return to Idle

note over V1,V2
Safety property:
Vehicle1.Crossing and Vehicle2.Crossing
must never be true at the same time.
end note

@enduml