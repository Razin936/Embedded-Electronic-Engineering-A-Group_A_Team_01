<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// ===== Global Declarations =====
// Communication channels
chan request;   // vehicle asks RSU for intersection entry
chan grant;     // RSU allows vehicle to enter
chan complete;  // vehicle tells RSU crossing is finished

// RSU decision timing clock (global, per spec Step 7)
clock decisionClock;

// Timing constants (milliseconds)
const int MAX_DECISION_TIME = 100;    // decision latency bound
const int CROSSING_TIME      = 3000;  // time to cross intersection
const int MAX_WAIT_TIME      = 10000; // bounded waiting time

// Shared state: is the intersection slot occupied?
bool slotOccupied = false;
</declaration>
	<template>
		<name x="5" y="5">Vehicle</name>
		<declaration>// Local clocks
clock x;          // general vehicle timing / crossing timer
clock waitClock;  // how long vehicle waits for grant
</declaration>
		<location id="id0" x="-510" y="0">
			<name x="-544" y="-42">Approaching</name>
		</location>
		<location id="id1" x="-340" y="0">
			<name x="-391" y="-42">Requesting</name>
		</location>
		<location id="id2" x="-170" y="0">
			<name x="-195" y="-34">Waiting</name>
			<label kind="invariant" x="-263" y="17">waitClock &lt;= MAX_WAIT_TIME</label>
		</location>
		<location id="id3" x="0" y="0">
			<name x="-17" y="-42">Crossing</name>
			<label kind="invariant" x="-34" y="17">x &lt;= CROSSING_TIME</label>
		</location>
		<location id="id4" x="187" y="0">
			<name x="161" y="-42">Completed</name>
		</location>
		<location id="id5" x="357" y="0">
			<name x="347" y="-34">Done</name>
		</location>
		<init ref="id0"/>
		<transition id="id6">
			<source ref="id5"/>
			<target ref="id5"/>
			<nail x="357" y="25"/>
			<nail x="374" y="25"/>
		</transition>
		<transition id="id7">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="assignment" x="-501" y="-25">x = 0</label>
		</transition>
		<transition id="id8">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="synchronisation" x="-314" y="-25">request!</label>
			<label kind="assignment" x="-331" y="-9">waitClock = 0</label>
		</transition>
		<transition id="id9">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="synchronisation" x="-127" y="-25">grant?</label>
			<label kind="assignment" x="-127" y="-9">x = 0</label>
		</transition>
		<transition id="id10">
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="guard" x="17" y="-25">x &gt;= CROSSING_TIME</label>
		</transition>
		<transition id="id11">
			<source ref="id4"/>
			<target ref="id5"/>
			<label kind="synchronisation" x="221" y="-25">complete!</label>
		</transition>
	</template>
	<template>
		<name>RSU_Controller</name>
		<location id="id12" x="-510" y="220">
			<name x="-535" y="186">Idle</name>
		</location>
		<location id="id13" x="-340" y="220">
			<name x="-391" y="178">ReceiveRequest</name>
			<committed/>
		</location>
		<location id="id14" x="-170" y="220">
			<name x="-186" y="186">Decision</name>
			<label kind="invariant" x="-263" y="237">decisionClock &lt;= MAX_DECISION_TIME</label>
		</location>
		<location id="id15" x="0" y="220">
			<name x="-16" y="186">Granting</name>
			<committed/>
		</location>
		<location id="id16" x="187" y="220">
			<name x="161" y="186">Occupied</name>
		</location>
		<location id="id17" x="357" y="220">
			<name x="331" y="186">ReleaseSlot</name>
			<committed/>
		</location>
		<init ref="id12"/>
		<transition id="id18">
			<source ref="id12"/>
			<target ref="id13"/>
			<label kind="synchronisation" x="-501" y="195">request?</label>
		</transition>
		<transition id="id19">
			<source ref="id13"/>
			<target ref="id14"/>
			<label kind="assignment" x="-331" y="195">decisionClock = 0</label>
		</transition>
		<transition id="id20">
			<source ref="id14"/>
			<target ref="id15"/>
			<label kind="guard" x="-127" y="170">slotOccupied == false</label>
			<label kind="assignment" x="-127" y="203">slotOccupied = true</label>
		</transition>
		<transition id="id21">
			<source ref="id15"/>
			<target ref="id16"/>
			<label kind="synchronisation" x="34" y="195">grant!</label>
		</transition>
		<transition id="id22">
			<source ref="id16"/>
			<target ref="id17"/>
			<label kind="synchronisation" x="221" y="195">complete?</label>
		</transition>
		<transition id="id23">
			<source ref="id17"/>
			<target ref="id12"/>
			<label kind="assignment" x="-220" y="280">slotOccupied = false</label>
			<nail x="357" y="320"/>
			<nail x="-510" y="320"/>
		</transition>
	</template>
	<system>// Instantiate processes
Vehicle1 = Vehicle();
RSU      = RSU_Controller();

// Composition (M/M/1: one vehicle, one RSU, one slot)
system Vehicle1, RSU;
</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>The system should never get stuck.</comment>
			<result outcome="success" type="quality" timestamp="2026-05-29 12:45:29 +0200">
			</result>
		</query>
		<query>
			<formula>A[] not (slotOccupied == true and RSU.Idle)</formula>
			<comment>RSU should not be idle while the slot is still occupied.</comment>
			<result outcome="success" type="quality" timestamp="2026-05-29 12:45:32 +0200">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Vehicle1.Done</formula>
			<comment>There exists a path where the vehicle crosses and finishes.</comment>
			<result outcome="success" type="quality" timestamp="2026-05-29 12:45:35 +0200">
			</result>
		</query>
		<query>
			<formula>A[] RSU.Decision imply decisionClock &lt;= MAX_DECISION_TIME</formula>
			<comment>While the RSU is deciding, decision time stays within 100 ms.</comment>
			<result outcome="success" type="quality" timestamp="2026-05-29 12:45:37 +0200">
			</result>
		</query>
	</queries>
</nta>
