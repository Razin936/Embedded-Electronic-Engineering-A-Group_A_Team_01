<nta>
<declaration>// ===== Global Declarations =====
// Compact UPPAAL model for V2V/V2I cross-traffic verification (M/M/1 abstraction).
// Same simple structure as the working demo file.

// V2I channels: vehicle request, RSU grant, crossing complete
chan request1;
chan request2;
chan request3;
chan request4;
chan grant1;
chan grant2;
chan grant3;
chan grant4;
chan complete1;
chan complete2;
chan complete3;
chan complete4;

// V2V intention beacon channels
chan beacon1;
chan beacon2;
chan beacon3;
chan beacon4;

// Clocks
clock decisionClock;

// Small abstract times for fast verification.
// In the report these represent scaled timing bounds.
const int MAX_DECISION_TIME = 2;
const int CROSSING_TIME = 3;
const int PHASE_TIME = 5;

// Server capacity: 1 = M/M/1 abstraction with one intersection service slot.
const int SERVER_CAP = 1;

// Phase order: 0=RIGHT_1, 1=STRAIGHT_NS, 2=RIGHT_2, 3=STRAIGHT_EW
int phase = 0;

// Shared RSU state
int activeCount = 0;
bool v1Waiting = false;
bool v2Waiting = false;
bool v3Waiting = false;
bool v4Waiting = false;
bool v1Inside = false;
bool v2Inside = false;
bool v3Inside = false;
bool v4Inside = false;
bool v1Beaconed = false;
bool v2Beaconed = false;
bool v3Beaconed = false;
bool v4Beaconed = false;
</declaration>
