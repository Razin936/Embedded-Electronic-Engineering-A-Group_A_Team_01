<transition id="id82"><source ref="id80"/><target ref="id80"/><label kind="synchronisation" x="-80" y="-30">beacon2?</label><nail x="-120" y="-20"/><nail x="120" y="-20"/></transition>
<transition id="id83"><source ref="id80"/><target ref="id80"/><label kind="synchronisation" x="-80" y="40">beacon3?</label><nail x="-120" y="50"/><nail x="120" y="50"/></transition>
<transition id="id84"><source ref="id80"/><target ref="id80"/><label kind="synchronisation" x="-80" y="80">beacon4?</label><nail x="-80" y="90"/><nail x="80" y="90"/></transition>
</template>

<template>
<name>RSU_Controller</name>
<location id="id100" x="-620" y="100"><name x="-650" y="116">Control</name></location>
<location id="id101" x="-430" y="-150"><name x="-470" y="-184">ReceiveV1</name><committed/></location>
<location id="id102" x="-430" y="-50"><name x="-470" y="-84">ReceiveV2</name><committed/></location>
<location id="id103" x="-430" y="150"><name x="-470" y="116">ReceiveV3</name><committed/></location>
<location id="id104" x="-430" y="250"><name x="-470" y="216">ReceiveV4</name><committed/></location>
<location id="id105" x="-170" y="100"><name x="-205" y="66">Decision</name><label kind="invariant" x="-270" y="116">decisionClock &lt;= MAX_DECISION_TIME</label></location>
<location id="id106" x="120" y="-150"><name x="90" y="-184">GrantV1</name><committed/></location>
<location id="id107" x="120" y="-50"><name x="90" y="-84">GrantV2</name><committed/></location>
<location id="id108" x="120" y="150"><name x="90" y="116">GrantV3</name><committed/></location>
<location id="id109" x="120" y="250"><name x="90" y="216">GrantV4</name><committed/></location>
<init ref="id100"/>

<!-- Receive V2I requests -->
<transition id="id110"><source ref="id100"/><target ref="id101"/><label kind="synchronisation" x="-620" y="-120">request1?</label><label kind="assignment" x="-620" y="-104">v1Waiting = true, decisionClock = 0</label></transition>
<transition id="id111"><source ref="id100"/><target ref="id102"/><label kind="synchronisation" x="-620" y="-20">request2?</label><label kind="assignment" x="-620" y="-4">v2Waiting = true, decisionClock = 0</label></transition>
<transition id="id112"><source ref="id100"/><target ref="id103"/><label kind="synchronisation" x="-620" y="170">request3?</label><label kind="assignment" x="-620" y="186">v3Waiting = true, decisionClock = 0</label></transition>
<transition id="id113"><source ref="id100"/><target ref="id104"/><label kind="synchronisation" x="-620" y="260">request4?</label><label kind="assignment" x="-620" y="276">v4Waiting = true, decisionClock = 0</label></transition>
<transition id="id114"><source ref="id101"/><target ref="id105"/></transition>
<transition id="id115"><source ref="id102"/><target ref="id105"/></transition>
<transition id="id116"><source ref="id103"/><target ref="id105"/></transition>
<transition id="id117"><source ref="id104"/><target ref="id105"/></transition>

<!-- Retry decision when a request is already waiting -->
<transition id="id118"><source ref="id100"/><target ref="id105"/><label kind="guard" x="-550" y="330">v1Waiting || v2Waiting || v3Waiting || v4Waiting</label><label kind="assignment" x="-550" y="346">decisionClock = 0</label><nail x="-620" y="350"/><nail x="-170" y="350"/></transition>

<!-- If current phase/capacity does not allow a grant, return to Control and retry later. -->
<transition id="id119"><source ref="id105"/><target ref="id100"/><label kind="guard" x="-420" y="-260">decisionClock &gt;= MAX_DECISION_TIME</label><label kind="assignment" x="-420" y="-244">decisionClock = 0</label><nail x="-170" y="-270"/><nail x="-620" y="-270"/></transition>

<!-- Grant logic: V1 and V2 are compatible right-turn vehicles; V3 and V4 are straight/conflicting vehicles. -->
<transition id="id120"><source ref="id105"/><target ref="id106"/><label kind="guard" x="-90" y="-190">v1Waiting &amp;&amp; activeCount &lt; SERVER_CAP &amp;&amp; (phase == 0 || phase == 2) &amp;&amp; !v3Inside &amp;&amp; !v4Inside</label><label kind="assignment" x="-90" y="-174">v1Waiting = false, v1Inside = true, activeCount = activeCount + 1</label></transition>
<transition id="id121"><source ref="id105"/><target ref="id107"/><label kind="guard" x="-90" y="-70">v2Waiting &amp;&amp; activeCount &lt; SERVER_CAP &amp;&amp; (phase == 0 || phase == 2) &amp;&amp; !v3Inside &amp;&amp; !v4Inside</label><label kind="assignment" x="-90" y="-54">v2Waiting = false, v2Inside = true, activeCount = activeCount + 1</label></transition>
<transition id="id122"><source ref="id105"/><target ref="id108"/><label kind="guard" x="-90" y="150">v3Waiting &amp;&amp; activeCount == 0 &amp;&amp; phase == 1</label><label kind="assignment" x="-90" y="166">v3Waiting = false, v3Inside = true, activeCount = activeCount + 1</label></transition>
<transition id="id123"><source ref="id105"/><target ref="id109"/><label kind="guard" x="-90" y="270">v4Waiting &amp;&amp; activeCount == 0 &amp;&amp; phase == 3</label><label kind="assignment" x="-90" y="286">v4Waiting = false, v4Inside = true, activeCount = activeCount + 1</label></transition>
<transition id="id124"><source ref="id106"/><target ref="id100"/><label kind="synchronisation" x="140" y="-170">grant1!</label></transition>
<transition id="id125"><source ref="id107"/><target ref="id100"/><label kind="synchronisation" x="140" y="-70">grant2!</label></transition>
<transition id="id126"><source ref="id108"/><target ref="id100"/><label kind="synchronisation" x="140" y="140">grant3!</label></transition>
<transition id="id127"><source ref="id109"/><target ref="id100"/><label kind="synchronisation" x="140" y="240">grant4!</label></transition>

<!-- Release server slots after vehicles complete crossing. -->
<transition id="id128"><source ref="id100"/><target ref="id100"/><label kind="guard" x="-760" y="-30">v1Inside</label><label kind="synchronisation" x="-760" y="-14">complete1?</label><label kind="assignment" x="-760" y="2">v1Inside = false, activeCount = activeCount - 1</label><nail x="-760" y="-60"/><nail x="-620" y="-60"/></transition>
<transition id="id129"><source ref="id100"/><target ref="id100"/><label kind="guard" x="-800" y="40">v2Inside</label><label kind="synchronisation" x="-800" y="56">complete2?</label><label kind="assignment" x="-800" y="72">v2Inside = false, activeCount = activeCount - 1</label><nail x="-820" y="20"/><nail x="-620" y="20"/></transition>
<transition id="id130"><source ref="id100"/><target ref="id100"/><label kind="guard" x="-800" y="160">v3Inside</label><label kind="synchronisation" x="-800" y="176">complete3?</label><label kind="assignment" x="-800" y="192">v3Inside = false, activeCount = activeCount - 1</label><nail x="-820" y="190"/><nail x="-620" y="190"/></transition>
<transition id="id131"><source ref="id100"/><target ref="id100"/><label kind="guard" x="-760" y="250">v4Inside</label><label kind="synchronisation" x="-760" y="266">complete4?</label><label kind="assignment" x="-760" y="282">v4Inside = false, activeCount = activeCount - 1</label><nail x="-760" y="280"/><nail x="-620" y="280"/></transition>
</template>

<template>
<name>Phase_Controller</name>
<declaration>clock p;</declaration>
<location id="id150" x="-480" y="0"><name x="-510" y="-34">Right1</name><label kind="invariant" x="-530" y="17">p &lt;= PHASE_TIME</label></location>
<location id="id151" x="-180" y="0"><name x="-230" y="-34">StraightNS</name><label kind="invariant" x="-230" y="17">p &lt;= PHASE_TIME</label></location>
<location id="id152" x="120" y="0"><name x="90" y="-34">Right2</name><label kind="invariant" x="70" y="17">p &lt;= PHASE_TIME</label></location>
<location id="id153" x="420" y="0"><name x="370" y="-34">StraightEW</name><label kind="invariant" x="370" y="17">p &lt;= PHASE_TIME</label></location>
<init ref="id150"/>
<transition id="id154"><source ref="id150"/><target ref="id151"/><label kind="guard" x="-390" y="-30">p &gt;= PHASE_TIME</label><label kind="assignment" x="-390" y="-14">phase = 1, p = 0</label></transition>
<transition id="id155"><source ref="id151"/><target ref="id152"/><label kind="guard" x="-90" y="-30">p &gt;= PHASE_TIME</label><label kind="assignment" x="-90" y="-14">phase = 2, p = 0</label></transition>
<transition id="id156"><source ref="id152"/><target ref="id153"/><label kind="guard" x="210" y="-30">p &gt;= PHASE_TIME</label><label kind="assignment" x="210" y="-14">phase = 3, p = 0</label></transition>
<transition id="id157"><source ref="id153"/><target ref="id150"/><label kind="guard" x="-50" y="120">p &gt;= PHASE_TIME</label><label kind="assignment" x="-50" y="136">phase = 0, p = 0</label><nail x="420" y="150"/><nail x="-480" y="150"/></transition>
</template>

<system>// Instantiate processes
Vehicle1 = Vehicle1_Template();
Vehicle2 = Vehicle2_Template();
Vehicle3 = Vehicle3_Template();
Vehicle4 = Vehicle4_Template();
RSU = RSU_Controller();
Phase = Phase_Controller();
V2VBus = V2VBus_Template();

// Composition: four vehicles, one RSU, one phase controller, one V2V channel bus
system Vehicle1, Vehicle2, Vehicle3, Vehicle4, RSU, Phase, V2VBus;
</system>
<queries>
<query><formula>A[] not deadlock</formula><comment>No deadlock in the compact M/M/1 V2V/V2I timed-automata network.</comment></query>
<query><formula>E&lt;&gt; Vehicle1.Done</formula><comment>Vehicle 1 can complete crossing.</comment></query>
<query><formula>E&lt;&gt; Vehicle2.Done</formula><comment>Vehicle 2 can complete crossing.</comment></query>
<query><formula>E&lt;&gt; Vehicle3.Done</formula><comment>Vehicle 3 can complete crossing.</comment></query>
<query><formula>E&lt;&gt; Vehicle4.Done</formula><comment>Vehicle 4 can complete crossing.</comment></query>
<query><formula>A[] activeCount &lt;= SERVER_CAP</formula><comment>M/M/1 capacity: the active vehicle count never exceeds one service slot.</comment></query>
<query><formula>A[] activeCount &lt;= 1</formula><comment>M/M/1 safety: only one vehicle can be inside/crossing at a time.</comment></query>
<query><formula>A[] RSU.Decision imply decisionClock &lt;= MAX_DECISION_TIME</formula><comment>RSU decision time stays bounded.</comment></query>
<query><formula>A[] not (Vehicle1.Crossing &amp;&amp; (Vehicle2.Crossing || Vehicle3.Crossing || Vehicle4.Crossing))</formula><comment>M/M/1: Vehicle 1 never crosses simultaneously with any other vehicle.</comment></query>
<query><formula>A[] not (Vehicle2.Crossing &amp;&amp; (Vehicle1.Crossing || Vehicle3.Crossing || Vehicle4.Crossing))</formula><comment>M/M/1: Vehicle 2 never crosses simultaneously with any other vehicle.</comment></query>
<query><formula>A[] not (Vehicle3.Crossing &amp;&amp; (Vehicle1.Crossing || Vehicle2.Crossing || Vehicle4.Crossing))</formula><comment>M/M/1: Vehicle 3 never crosses simultaneously with any other vehicle.</comment></query>
<query><formula>A[] not (Vehicle4.Crossing &amp;&amp; (Vehicle1.Crossing || Vehicle2.Crossing || Vehicle3.Crossing))</formula><comment>M/M/1: Vehicle 4 never crosses simultaneously with any other vehicle.</comment></query>
<query><formula>E&lt;&gt; (v1Beaconed &amp;&amp; v2Beaconed &amp;&amp; v3Beaconed &amp;&amp; v4Beaconed)</formula><comment>All vehicles can send V2V beacon messages.</comment></query>
<query><formula>E&lt;&gt; phase == 3</formula><comment>The phase controller can reach the STRAIGHT_EW phase.</comment></query>
</queries>
</nta>
